{% extends '/website/frontend/cms_base.html.twig' %}

{% block cms_content %}
    <!-- Hero Start -->
    <section class="bg-half-170 bg-light d-table w-100">
        <div class="container">
            <div class="row mt-5 justify-content-center">
                <div class="col-lg-12 text-center">
                    <div class="pages-heading">
                        <h4 class="title mb-0">{{ activeMenuItem['contentTitle'] ?? 'Блог' }}</h4>
                    </div>
                </div>
            </div>
            <div class="position-breadcrumb">
                <nav aria-label="breadcrumb" class="d-inline-block">
                    <ul class="breadcrumb rounded shadow mb-0 px-4 py-2">
                        <li class="breadcrumb-item"><a href="/">Начало</a></li>
                        <li class="breadcrumb-item active" aria-current="page">{{ activeMenuItem['contentTitle'] ?? 'Блог' }}</li>
                    </ul>
                </nav>
            </div>
        </div>
    </section>

    <div class="position-relative">
        <div class="shape overflow-hidden text-color-white">
            <svg viewBox="0 0 2880 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0 48H1437.5H2880V0H2160C1442.5 52 720 0 720 0H0V48Z" fill="currentColor"></path>
            </svg>
        </div>
    </div>

    <!-- Blog Start -->
    <section class="section">
        <div class="container">
            <div class="row">
                {% for post in posts %}
                    <div class="col-lg-4 col-md-6 mb-4 pb-2">
                        <div class="card blog blog-primary rounded border-0 shadow overflow-hidden">
                            <div class="position-relative">
                                {% if post.leadingImage %}
                                    <img src="{{ asset(post.leadingImage.webDir ~ '/' ~ post.leadingImage.uniqueFilename) }}" class="card-img-top" alt="{{ post.title }}">
                                {% else %}
                                    <img src="{{ asset('website/frontend/images/ds-module-system-logo2.png') }}" class="card-img-top" alt="{{ post.title }}" style="padding: 10px;">
                                {% endif %}
                                <div class="overlay rounded-top"></div>
                            </div>
                            <div class="card-body content">
                                <h5><a href="{{ cms_path_by_id(menuId) }}/{{ post.slug }}" class="card-title title text-dark">{{ post.title }}</a></h5>
                                {% if post.description %}
                                    <p class="text-muted">{{ post.description|striptags|slice(0, 120) }}{% if post.description|striptags|length > 120 %}...{% endif %}</p>
                                {% endif %}
                                <div class="post-meta d-flex justify-content-between mt-3">
                                    <a href="{{ cms_path_by_id(menuId) }}/{{ post.slug }}" class="text-muted readmore">{{ 'blog.readMore'|trans({}, 'website_blog') }} <i class="uil uil-angle-right-b align-middle"></i></a>
                                </div>
                            </div>
                            <div class="author">
                                <small class="date"><i class="uil uil-calendar-alt"></i> {{ post.createdAt|date('d.m.Y') }}</small>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12 text-center py-5">
                        <p class="text-muted">{{ 'blog.noPosts'|trans({}, 'website_blog') }}</p>
                    </div>
                {% endfor %}
            </div>

            {% if posts.pageCount > 1 %}
                <div class="row mt-4">
                    <div class="col-12">
                        {{ knp_pagination_render(posts) }}
                    </div>
                </div>
            {% endif %}
        </div>
    </section>
{% endblock %}
