<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
{% for entry in urls %}
    <url>
        <loc>{{ entry.loc }}</loc>
{% if entry.lastmod %}
        <lastmod>{{ entry.lastmod }}</lastmod>
{% endif %}
{% for locale, href in entry.alternates %}
        <xhtml:link rel="alternate" hreflang="{{ locale }}" href="{{ href }}"/>
{% endfor %}
{% if entry.alternates.bg is defined %}
        <xhtml:link rel="alternate" hreflang="x-default" href="{{ entry.alternates.bg }}"/>
{% endif %}
    </url>
{% endfor %}
</urlset>
