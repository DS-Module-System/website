{% extends 'base.html.twig' %}

{% import 'core/default_templates/form_table_macro.html.twig' as form_table %}

{% set form_btns = form_table.btns('website_menu_tree', form, true, {}, {'defaultSave':true, 'saveAndContinueEdit':true,'saveAndNew': false}) %}

{# {% block javascript %}
{{ parent() }}
{{ encore_entry_script_tags('admin_app_tinymce') }}
{% endblock %} #}

{% block body %}
    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
    {{ form_row(form._token) }}
    <div class="row">
        <div class="col-md-12 col-lg-9">
            <div class="card">
                <div class="card-body">
                    <h4 class="header-title">{{ 'website_menu.editRecordTitle'|dtrans }}</h4>
                    {{ form_btns }}
                    <div class="mt-3 mb-2 {% if not form.vars.valid %}was-validated{% endif %}">
                        {% include 'core/default_templates/form_main_error.html.twig' %}
                        {% if pageModule != 'redirect_page' %}
                            {% include 'website/menu/form_fields.html.twig' with {"form": form, 'pageModule':pageModule} only %}
                        {% endif %}
                        {% include 'website/menu/'~pageModule~'_form_fields.html.twig' with {"form": form} only %}
                    </div>
                    {{ form_btns }}
                </div>
            </div>
        </div>
    </div>
    {{ form_end(form, {'render_rest': false}) }}
{% endblock %}
