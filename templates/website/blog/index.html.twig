{% extends 'base.html.twig' %}

{% import 'core/default_templates/data_table_macro.html.twig' as data_table %}

{% block body %}
    <div class="row">
        <div class="col-12">
            {{ data_table.table(rows, {
                "newLink": data_table.new_btn('website_blog_create'),
                "cols" : {
                    "tableAction": {
                        "label": "core.module.actionTitle",
                        "edit": path('website_blog_edit', {"id": -1}),
                    },
                    "title": {
                        "label": "website_blog.title",
                        "trans": true,
                    },
                    "slug": {
                        "label": "website_blog.slug",
                        "trans": true,
                    },
                    "createdAt": {
                        "label": "website_blog.createdAt",
                        "type": "datetime",
                        "trans": true,
                    },
                }
            }) }}
        </div>
    </div>
{% endblock %}
