{% extends 'base.html.twig' %}

{% import 'core/default_templates/form_table_macro.html.twig' as form_table %}

{% set form_btns = form_table.btns('website_blog_list', form, isEdit, {}) %}

{% block body %}
    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
    {{ form_row(form._token) }}
    <div class="row">
        <div class="col-md-12 col-lg-9">
            <div class="card">
                <div class="card-body">
                    <h4 class="header-title">
                        {% if isEdit %}
                            {{ 'website_blog.editRecordTitle'|dtrans }}
                        {% else %}
                            {{ 'website_blog.createRecordTitle'|dtrans }}
                        {% endif %}
                    </h4>
                    {{ form_btns }}
                    <div class="mt-3 mb-2 {% if not form.vars.valid %}was-validated{% endif %}">
                        {% include 'core/default_templates/form_main_error.html.twig' %}
                        {{ form_table.tr(form.leadingImage) }}
                        {{ form_table.tr(form.isActive) }}
                        {{ form_table.tr(form.title) }}
                        {{ form_table.tr(form.slug) }}
                        {{ form_table.tr(form.description) }}
                        {{ form_table.tr(form.content) }}
                    </div>
                    {{ form_btns }}
                </div>
            </div>
        </div>
    </div>
    {{ form_end(form, {'render_rest': false}) }}
{% endblock %}
